# Allowlist: ignore everything, then re-include code and standard project files.
*
!*/

# Code
!*.py
!*.ipynb
!*.md
!*.yaml
!*.yml

# Standard project files
!.gitignore
!.gitattributes
!.python-version
!pyproject.toml
!uv.lock
!requirements*.txt
!LICENSE

# Never track these, even if they contain allowlisted files
.venv/
venv/
env/
out/
build/
dist/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.vscode/
.idea/
